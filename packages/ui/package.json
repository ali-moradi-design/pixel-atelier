{
  "name": "pixel-atelier",
  "version": "0.0.0",
  "description": "Pixels, crafted with care. A calm React UI kit whose pixel effects appear only at the moment of interaction.",
  "license": "MIT",
  "author": "Ali Moradi",
  "homepage": "https://pixel-atelier.ali-moradi-develop.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-moradi-design/pixel-atelier.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "radix",
    "pixel",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --log-level warn && node scripts/build-css.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "size": "size-limit && node scripts/css-size.ts"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1"
  },
  "devDependencies": {
    "@pixel-atelier/tokens": "workspace:*",
    "@size-limit/preset-small-lib": "14.2.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.2.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
