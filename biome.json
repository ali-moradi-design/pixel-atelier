{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/storybook-static",
      "!design/mockups",
      "!brand",
      "!apps/docs/public",
      "!apps/docs/.next",
      "!apps/docs/out",
      "!apps/docs/content"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/components/cursor-trail.tsx",
        "packages/ui/src/components/image-reveal.tsx",
        "packages/ui/src/components/page-transition.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaHiddenOnFocusable": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/components/code-block.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
